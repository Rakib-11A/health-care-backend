model Appoinment {
    id             String           @id @default(uuid())
    videoCallingId String
    status         AppoinmentStatus @default(SCHEDULED)
    paymentStatus  PaymentStatus    @default(UNPAID)
    createdAt      DateTime         @default(now())
    updatedAt      DateTime         @updatedAt

    // Relation
    patiendId String
    patient   Patient @relation(fields: [patiendId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    doctorId String
    doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    scheduleId String   @unique
    schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    prescription Prescription?
    review       Review?
    payment      Payment?

    @@index([patiendId])
    @@index([doctorId])
    @@index([scheduleId])
    @@index([status])
    @@map("appoinments")
}
