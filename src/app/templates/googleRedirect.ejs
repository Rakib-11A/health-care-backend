<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Google Login</title>
</head>
<body>
    <div>
        <p>Redirecting To Google...</p>
    </div>
</body>
<script>
    (
        async () => {
            try {
                const response = await fetch("<%= betterAuthUrl %>/api/auth/sign-in/social", {
                    method : "POST",
                    headers : {
                        "Content-Type" : "application/json"
                    },
                    credentials : "include",
                    body: JSON.stringify({
                        provider : "google",
                        callbackURL: "<%= callbackURL %>"
                    })
                })

                const data = await response.json();

                if (data.url) {
                    window.location.href = data.url;
                } else {
                    const errorMsg = data.message || data.error || "No redirect URL returned from server.";
                    document.body.innerHTML = `<div>
                    <p><strong>Error Occurred While Redirecting To Google. Please Try Again Later.</strong></p>
                    <p>Details: ${errorMsg}</p>
                    <p>Check: 1) GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET in .env 2) In Google Cloud Console add redirect URI: <%= betterAuthUrl %>/api/auth/callback/google</p>
                    </div>`;
                }
            } catch (error) {
                const errMsg = error && error.message ? error.message : String(error);
                document.body.innerHTML = `<div>
                    <p><strong>Error Occurred While Redirecting To Google. Please Try Again Later.</strong></p>
                    <p>Details: ${errMsg}</p>
                    <p>Check: BETTER_AUTH_URL in .env should match this site (e.g. http://localhost:5000).</p>
                    </div>`;
                }
        }
    )()
</script>
</html>